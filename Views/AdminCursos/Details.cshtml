@model PortalAcademico.Models.Curso
@{
    ViewData["Title"] = "Detalle del curso";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

<div class="card">
  <div class="card-body">
    <dl class="row">
      <dt class="col-sm-3">Código</dt>      <dd class="col-sm-9">@Model.Codigo</dd>
      <dt class="col-sm-3">Nombre</dt>      <dd class="col-sm-9">@Model.Nombre</dd>
      <dt class="col-sm-3">Créditos</dt>    <dd class="col-sm-9">@Model.Creditos</dd>
      <dt class="col-sm-3">Cupo Máx.</dt>   <dd class="col-sm-9">@Model.CupoMaximo</dd>
      <dt class="col-sm-3">Horario</dt>     <dd class="col-sm-9">@Model.HorarioInicio.ToString(@"hh\:mm") – @Model.HorarioFin.ToString(@"hh\:mm")</dd>
      <dt class="col-sm-3">Activo</dt>      <dd class="col-sm-9">@(Model.Activo ? "Sí" : "No")</dd>
    </dl>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary ms-2">Volver</a>
  </div>
</div>
