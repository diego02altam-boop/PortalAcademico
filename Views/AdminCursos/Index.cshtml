@model IEnumerable<PortalAcademico.Models.Curso>

@{
    ViewData["Title"] = "Cursos (Panel coordinador)";
}

<h1>@ViewData["Title"]</h1>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

<p>
    <a asp-controller="AdminCursos" asp-action="Create" class="btn btn-primary">Nuevo curso</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th class="text-center">Créditos</th>
            <th class="text-center">Cupo Máx.</th>
            <th>Horario</th>
            <th class="text-center">Activo</th>
            <th class="text-end" style="width:320px;"></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Codigo</td>
            <td>@item.Nombre</td>
            <td class="text-center">@item.Creditos</td>
            <td class="text-center">@item.CupoMaximo</td>
            <td>@item.HorarioInicio.ToString(@"hh\:mm") – @item.HorarioFin.ToString(@"hh\:mm")</td>
            <td class="text-center">@(item.Activo ? "Sí" : "No")</td>
            <td class="text-end">
                <a asp-controller="AdminCursos"
                   asp-action="Matriculas"
                   asp-route-cursoId="@item.Id"
                   class="btn btn-sm btn-outline-primary">Ver matrículas</a>

                <a asp-controller="AdminCursos"
                   asp-action="Edit"
                   asp-route-id="@item.Id"
                   class="btn btn-sm btn-outline-secondary">Editar</a>

                <a asp-controller="AdminCursos"
                   asp-action="Details"
                   asp-route-id="@item.Id"
                   class="btn btn-sm btn-outline-info">Detalle</a>

                <a asp-controller="AdminCursos"
                   asp-action="Delete"
                   asp-route-id="@item.Id"
                   class="btn btn-sm btn-outline-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
