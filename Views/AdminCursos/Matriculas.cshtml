@using PortalAcademico.Controllers
@model IEnumerable<AdminCursosController.MatriculaVM>

@{
    var curso = (PortalAcademico.Models.Curso)ViewBag.Curso;
    ViewData["Title"] = $"Matrículas – {curso.Nombre} ({curso.Codigo})";
}

<h1 class="mb-3">@ViewData["Title"]</h1>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success">@ok</div>
}

<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Estudiante (email)</th>
          <th>Estado</th>
          <th>Fecha</th>
          <th class="text-end" style="width:220px;"></th>
        </tr>
      </thead>
      <tbody>
      @foreach (var m in Model)
      {
        <tr>
          <td data-th="Estudiante">@m.Usuario</td>
          <td data-th="Estado">@m.Estado</td>
          <td data-th="Fecha">@m.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</td>
          <td class="text-end action-bar" data-th="">
              <!-- POST /Coordinador/Cursos/Confirmar  (id en el body) -->
              <form asp-controller="AdminCursos" asp-action="Confirmar" method="post" class="d-inline">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@m.Id" />
                  <button type="submit" class="btn btn-sm btn-success">Confirmar</button>
              </form>

              <!-- POST /Coordinador/Cursos/Cancelar   (id en el body) -->
              <form asp-controller="AdminCursos" asp-action="Cancelar" method="post" class="d-inline ms-1">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@m.Id" />
                  <button type="submit" class="btn btn-sm btn-danger">Cancelar</button>
              </form>
          </td>
        </tr>
      }
      </tbody>
    </table>
  </div>
</div>

<div class="mt-3">
  <a asp-controller="AdminCursos" asp-action="Index" class="btn btn-secondary">Volver</a>
  <a asp-controller="AdminCursos" asp-action="Details" asp-route-id="@curso.Id" class="btn btn-link ms-2">
      ← Volver a @curso.Nombre
  </a>
</div>
